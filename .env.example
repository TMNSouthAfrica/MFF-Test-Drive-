# Set in Vercel → Project → Settings → Environment Variables
PABBLY_WEBHOOK_URL=

# Spin-to-win (optional)
# Total chance (0–1) that a spin wins any vehicle. Default 0.03 (3%).
SPIN_WIN_CHANCE=
# Send spin results to a different Pabbly workflow. Defaults to PABBLY_WEBHOOK_URL.
PABBLY_SPIN_WEBHOOK_URL=
# TESTING ONLY: win | lose | 3xo | xuv700 | scorpio-n. Leave unset in production.
SPIN_FORCE_RESULT=
